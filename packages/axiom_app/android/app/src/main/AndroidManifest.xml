<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET — für den Expertenmodus (ADR-0005).

      Bis dahin war die Berechtigung bewusst weggelassen: Damit war auf
      Betriebssystemebene ausgeschlossen, dass Daten das Gerät verlassen.
      Diese strukturelle Garantie gibt es nicht mehr.

      An ihre Stelle tritt eine engere, getestete Zusage: **AXIOM ruft nichts
      von sich aus auf.** Kein HTTP-Client, keine ausgehende Verbindung, kein
      SDK, das eine aufbauen könnte — `language_test.dart` verbietet
      `package:http`, `HttpClient`, `Socket.connect` und `dart:html` im
      gesamten App-Code. Die App lauscht, und nur solange der Expertenmodus
      ausdrücklich eingeschaltet ist.
    -->
    <uses-permission android:name="android.permission.INTERNET" />


    <!-- Minutengenaue Zeitanker. Wirksamster Interventionstyp [D4]. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Samsung beendet Hintergrundprozesse aggressiv. Ohne Ausnahme feuern
      Alarme unzuverlässig — und unzuverlässige Zeittrigger entwerten das
      gesamte Konzept (Risiko R4).
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Foreground-Service für die dauerhafte Anzeige und aktive Slots.
      Der Dienst zeigt Zustand an und nimmt Eingaben entgegen — dafür ist
      SPECIAL_USE der vorgesehene Typ.
    -->
    <!--
      Ohne diese Berechtigung ignoriert Android 16 jedes
      `setRequestPromotedOngoing` — die Benachrichtigung bleibt eine
      gewoehnliche, und weder Statusleisten-Pille noch Samsungs Now Bar
      zeigen sie. Der Aufruf stand seit S3 im Code und lief ins Leere.
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
      Ohne diese Berechtigung und ohne MulticastLock verwirft Androids
      WLAN-Treiber eingehende Multicast-Pakete, bevor die App sie sieht.
      Der mDNS-Responder hoerte dann nie eine Frage nach `axiom.local` —
      ohne Fehler, ohne Log, einfach still.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Backward-Chaining für Zeitanker (M3). Nur lesend. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Health Connect: granular, jede einzeln widerrufbar. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <application
        android:label="AXIOM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Aus jeder App heraus nach AXIOM teilen = erfassen [D9]. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Sprache: "Notiz in AXIOM" über Assistant und Bixby. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="axiom" />
            </intent-filter>

            <!--
              Health Connect verlangt, dass die App erklären kann, wofür sie
              Gesundheitsdaten liest — sonst erteilt das System die Freigabe
              nicht. Bis Android 13 über diese Aktion.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          Derselbe Zweck ab Android 14. Die Berechtigung stellt sicher, dass
          nur das System diesen Einstieg auslösen kann.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Stift-Schnittstelle des Systems (Android 14+).

          Damit erscheint AXIOM beim Doppeltipp mit dem S-Pen, in der
          Schnelleinstellung "Notiz" und auf dem Sperrbildschirm. Samsung
          Notes hat keine öffentliche Schnittstelle — das hier ist der
          einzige Weg, der ohne Reverse Engineering funktioniert und ein
          Update überlebt.

          Zusätzlich lässt sich diese Activity in Samsungs "Air Actions"
          auf den Stiftknopf legen.
        -->
        <activity
            android:name=".CreateNoteActivity"
            android:exported="true"
            android:label="@string/label_create_note"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:showWhenLocked="true">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Erfassen und Check-in direkt vom Launcher (langes Tippen). -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <!--
          Homescreen-Widget: nächste Handlung und Kapazität permanent
          sichtbar. Was nicht sichtbar ist, existiert für dieses Profil
          nicht [D9].
        -->
        <!--
          exported MUSS true sein: Der Launcher laeuft in einem anderen
          Prozess und muss den Update-Broadcast senden koennen. Mit false
          laesst sich das Widget nicht hinzufuegen.
        -->
        <receiver
            android:name=".AxiomWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/axiom_widget_info" />
        </receiver>

        <!--
          Dauerhafte Anzeige im Benachrichtigungsbereich.

          Erscheint auch auf dem Sperrbildschirm — Lockscreen-Widgets gibt
          es auf Android seit 5.0 nicht mehr, die dauerhafte Benachrichtigung
          ist der verbliebene Weg zu ständiger Sichtbarkeit [D9].
        -->
        <service
            android:name=".PresenceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_presence" />
        </service>

        <!--
          Laufender Slot als Live Update: Statusleisten-Pille, Sperrbildschirm
          und Samsungs Now Bar (Android 16+). Der fehlende Ausstieg ist der
          teuerste Fehlermodus im Fokus [D6] — die Restzeit muss sichtbar
          sein, ohne dass man nachsieht.
        -->
        <service
            android:name=".LiveSlotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_live" />
        </service>

        <!--
          Hält den Prozess am Leben, solange der Expertenmodus läuft, und
          zeigt sichtbar an, dass ein Port offen ist (ADR-0005).
        -->
        <service
            android:name=".ExpertService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_expert" />
        </service>

        <!-- Nimmt Text entgegen, der in der Benachrichtigung getippt wurde. -->
        <receiver
            android:name=".QuickCaptureReceiver"
            android:exported="false" />

        <!-- Empfängt exakte Alarme und zeigt die Intervention an. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false"
            android:enabled="true" />

        <!--
          Nimmt den aktuellen Ort von einer Geräteroutine entgegen — das
          Gegenstück zu den ausgehenden Broadcasts.

          Damit setzt eine Samsung-Routine „WLAN Büro verbunden" den Ort,
          ohne dass AXIOM eine Standortberechtigung braucht. Kein GPS, kein
          Geofence, kein ACCESS_BACKGROUND_LOCATION und kein dauerhaft
          messender Dienst — ein verbundenes WLAN ist ohnehin genauer als
          ein Kreis mit 200 m Radius.

          exported MUSS true sein: Die Routinen-App ist ein anderer Prozess.

          Bewusst OHNE android:permission. Das prüft den Sender, und Samsungs
          Routinen halten keine selbst definierte Berechtigung von AXIOM —
          der Broadcast käme stumm nie an. Der Empfänger gibt nichts heraus,
          liest nichts und kann nichts auslösen außer einer Ortsangabe; ein
          falsch gesetzter Ort steht sichtbar in der Hauptansicht und ist in
          zwei Tipps zurückgesetzt.
        -->
        <receiver
            android:name=".PlaceReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="de.atomfritte.axiom.PLACE" />
            </intent-filter>
        </receiver>

        <!-- Stellt Alarme nach Neustart und Update wieder her. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Schnelleinstellung: Erfassen mit einem Tipp aus jedem Kontext,
          ohne die App zu suchen.
        -->
        <service
            android:name=".CaptureTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/label_capture_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
      Paketsichtbarkeit (Android 11+). Ohne diese Eintraege meldet das System
      "nicht vorhanden" statt "nicht freigegeben" — und die App zeigt dann
      eine Funktion als fehlend an, die in Wahrheit nur unsichtbar ist.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>

        <!--
          Health Connect: eigene App bis Android 13, Systemmodul ab 14. Ohne
          beide Namen meldet getSdkStatus "nicht vorhanden", obwohl der
          Dienst laeuft — und der Freigabedialog oeffnet sich nie.
        -->
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.healthconnect.controller" />
        <package android:name="com.android.healthconnect.controller" />
        <intent>
            <action android:name="androidx.health.ACTION_HEALTH_CONNECT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="androidx.health.ACTION_REQUEST_PERMISSIONS" />
        </intent>

        <!-- Spracherkennung fuer die Diktierfunktion beim Erfassen. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
</manifest>
