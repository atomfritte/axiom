<?xml version="1.0" encoding="utf-8"?>
<!--
  Systemtexte in der Standardsprache — Englisch.

  Warum Englisch hier und Deutsch unter `values-de/`, obwohl Deutsch die
  Quellsprache des Projekts ist: `values/` ist der Rueckfall fuer jede
  Geraetesprache, die sonst nirgends passt. Genau dieselbe Entscheidung
  trifft `AppLanguage.fromLocale` (unbekannte Sprache → Englisch), und beide
  Seiten muessen dasselbe tun. Ein deutsches `values/` hiesse: Wer sein
  Geraet auf Franzoesisch stellt, bekommt eine englische App mit deutschen
  Benachrichtigungen.

  Diese Datei ist nur der Rueckfall. Sobald die App einmal gelaufen ist,
  ueberschreibt `SystemTexts` diese Saetze mit denen der in der App
  gewaehlten Sprache (siehe AxiomTexts.kt). Was hier steht, sieht man also
  vor dem allerersten Start, nach einem Neustart bevor die App wieder lief,
  und in der Widget-Auswahl.
-->
<resources>

    <!-- ── Was das System ohne die App zeichnet ───────────────────────── -->

    <string name="widget_description">The next action and your capacity today, without opening the app.</string>
    <string name="shortcut_capture_short">Capture</string>
    <string name="shortcut_capture_long">Hold on to a thought</string>
    <string name="shortcut_checkin_short">Check-in</string>
    <string name="shortcut_checkin_long">Measure state</string>
