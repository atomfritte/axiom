<?xml version="1.0" encoding="utf-8"?>
<!--
  Vorschau in der Widget-Auswahl. Zeigt Beispielinhalt statt eines leeren
  Kastens — sonst weiss niemand, was er sich da auf den Bildschirm legt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/axiom_widget_label"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:fontFamily="monospace"
        android:textColor="@color/axiom_ink_faint" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:text="@string/axiom_preview_headline"
        android:textSize="19sp"
        android:textColor="@color/axiom_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/axiom_preview_detail"
        android:textSize="12sp"
        android:textColor="@color/axiom_ink_dim" />

    <!--
      Abstandhalter als FrameLayout, nicht als <View>.

      RemoteViews laesst nur Klassen zu, die mit @RemoteView annotiert sind —
      android.view.View gehoert nicht dazu. Der Launcher bricht die
      Inflation ab und zeigt "Widget kann nicht angezeigt werden". Von
      aussen sieht das aus wie ein kaputtes Widget; tatsaechlich ist es eine
      einzige nicht erlaubte Zeile.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="61"
        android:progressDrawable="@drawable/widget_bar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/axiom_preview_capacity"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:fontFamily="monospace"
        android:textColor="@color/axiom_signal" />
</LinearLayout>
